<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%= title %></title>
</head>

<body>
  <%- include('partials/header.ejs') %>
  <h2><%= title %></h2>
  <div class="toplink">
    <a href="/genres/<%= genre.genre_id %>/update">Edit</a>
    <a href="/genres/<%= genre.genre_id %>/delete">Delete</a>
  </div>
  <% if (videogames.length > 0) { %>
  <ul>
    <% videogames.forEach(videogame=>{ %>
    <li><a href="/videogames/<%= videogame.videogame_id %>"><%= videogame.title %></a></li>
    <% }) %>
  </ul>
  <% } else { %>
  <p>There are no games in this genre.</p>
  <% } %>
</body>

</html>