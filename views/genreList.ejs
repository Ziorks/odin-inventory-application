<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%= title %></title>
</head>

<body>
  <%- include('partials/header.ejs') %>
  <h2><%= title %></h2>
  <a href="/genres/create" class="toplink">Create a new genre</a>
  <% if (genres.length > 0) { %>
  <ul>
    <% genres.forEach(genre=>{ %>
    <li><a href="/genres/<%= genre.genre_id %>"><%= genre.genre %></a></li>
    <% }) %>
  </ul>
  <% } else { %>
  <p>There are no genres.</p>
  <% } %>
</body>

</html>